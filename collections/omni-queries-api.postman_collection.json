              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"jobs_submitted\": {},\n  \"job_id\": \"c2d53d79-4369-6ccc-a8a1-37a3c7988820\",\n  \"status\": \"string\",\n  \"client_result_id\": \"6c8fb2e6-f5b1-d255-dfda-f5b0e8016136\",\n  \"summary\": {},\n  \"cache_metadata\": {},\n  \"query\": {},\n  \"result\": \"string\",\n  \"stream_stats\": {\n    \"server_stream\": 3018\n  },\n  \"remaining_job_ids\": [\n    \"8fcc2d35-9137-f754-c19d-2b6effb53712\",\n    \"f7134e62-2e5e-4848-3b2d-847d3eec7004\"\n  ],\n  \"timed_out\": \"string\"\n}",

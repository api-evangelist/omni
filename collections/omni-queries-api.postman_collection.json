          "name": "Wait for query results",
          "request": {
            "name": "Wait for query results",
            "description": {
              "content": "Polls for the results of one or more query jobs. Use this endpoint when a request to the [Run query endpoint](/api/queries/run-query) times out and returns `remaining_job_ids` in the response.\n\nThis endpoint will wait for the specified jobs to complete and return their results. If the jobs are still processing when the request times out, the response will include the remaining job IDs to poll again.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "query",
                "wait"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "job_ids",
                  "value": "<uuid>",
                  "description": "(Required) An array of job IDs to poll for results. These IDs are returned in the `remaining_job_ids` property when a request to the [Run query endpoint](/api/queries/run-query) times out.\n\nFormat the parameter as a JSON array (e.g., `?job_ids=[\"job-id-1\",\"job-id-2\"]`).\n"
                },
                {
                  "disabled": false,
                  "key": "job_ids",

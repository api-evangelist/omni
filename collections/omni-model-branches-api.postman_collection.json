              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"delete_branch\": false,\n  \"publish_drafts\": true,\n  \"commit_message\": \"<string>\",\n  \"force_override_git_settings\": false\n}",

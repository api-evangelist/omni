          "name": "Merge a branch",
          "request": {
            "name": "Merge a branch",
            "description": {
              "content": "Merges a model branch into the shared model.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "models",
                ":modelId",
                "branch",
                ":branchName",
                "merge"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "modelId",
                  "description": "(Required) The unique identifier of the model"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "branchName",
                  "description": "(Required) The name of the branch to merge"
                },
                {
                  "description": "Your production Omni instance subdomain",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },

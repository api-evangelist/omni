{
  "opencollection": "1.0.0",
  "info": {
    "name": "Omni AI Content migration API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Content migration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Export dashboard",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.omniapp.co/api/unstable/documents/:dashboardId/export",
            "params": [
              {
                "name": "dashboardId",
                "value": "",
                "type": "path",
                "description": "Dashboard identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Export dashboard for migration between Omni instances"
        },
        {
          "info": {
            "name": "Import dashboard",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{instance}.omniapp.co/api/unstable/documents/import",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Import dashboard to Omni instance.\n"
        }
      ]
    }
  ],
  "bundled": true
}
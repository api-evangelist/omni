    {
      "id": "71b90fa4-d7db-41da-b7f7-3e8ae75c033e",
      "name": "Content validator",
      "description": {
        "content": "Validate content against models and perform find/replace operations",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "9454dedd-6178-4562-90e8-e978829fa5b2",
          "name": "Validate content",
          "request": {
            "name": "Validate content",
            "description": {
              "content": "Validates all content against the model and returns documents with queries and any validation issues.\n\nThis endpoint scans all documents associated with the model and identifies any fields, views, or other model elements referenced in queries that are no longer valid.\n\nYou can optionally scope validation to only content that references a specific model element (view, field, or topic) using the `find` and `find_type` parameters. This is useful when you only need to validate content using a specific element, avoiding the overhead of validating all documents.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "models",
                ":modelId",
                "content-validator"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "branch_id",
                  "value": "<uuid>",
                  "description": "The ID of the branch to validate against. If not provided, validates against the main model."
                },
                {
                  "disabled": false,
                  "key": "userId",
                  "value": "<uuid>",
                  "description": "The user ID to act on behalf of. Only valid when using an organization API key.\n\nUser-scoped API keys cannot use this parameter and will receive a 403 error if provided.\n"
                },
                {
                  "disabled": false,
                  "key": "include_personal_folders",
                  "value": "<boolean>",
                  "description": "When enabled, include personal folders in the search."
                },
                {
                  "disabled": false,
                  "key": "find",
                  "value": "<string>",
                  "description": "The name of the model element to find content references for. Must be used together with `find_type`.\n\nFor `FIELD` type, the value must be fully qualified with the view name (e.g., `orders.status`).\n"
                },
                {
                  "disabled": false,
                  "key": "find_type",
                  "value": "<string>",
                  "description": "The type of model element to search for. Must be used together with `find`.\n\nWhen both parameters are provided, only content that references the specified element will be validated and included in the response.\n"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "modelId",
                  "description": "(Required) The ID of the model to validate content against."
                },
                {
                  "description": "Your production Omni instance subdomain",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },

            {
              "name": "Retrieve content",
              "id": "1a5da4dc-570f-4a48-85c8-7fe3bca54657",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{bearerToken}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/v1/content?labels=<string>&scope=organization&sortField=name&sortDirection=asc&include=<string>&folderId=<uuid>&path=<string>&creatorId=<uuid>&pageSize=20&cursor=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "v1",
                    "content"
                  ],
                  "query": [
                    {
                      "description": "Filter content by labels. Provide as a comma-separated list (e.g., `finance,marketing`).",
                      "key": "labels",
                      "value": "<string>"
                    },
                    {
                      "description": "Content scope filter",
                      "key": "scope",
                      "value": "organization"
                    },
                    {
                      "description": "Field to sort by",
                      "key": "sortField",
                      "value": "name"
                    },
                    {
                      "description": "Direction for sorting:\n\n- `asc` - Ascending order (A-Z, 0-9)\n- `desc` - Descending order (Z-A, 9-0)\n",
                      "key": "sortDirection",
                      "value": "asc"
                    },
                    {
                      "description": "Comma-separated list of additional fields to include in the response:\n- `_count` - Adds count metrics (folders: document and favorite counts; documents: favorite and view counts)\n- `labels` - Includes associated content labels\n",
                      "key": "include",
                      "value": "<string>"
                    },
                    {
                      "description": "Returns all content in the specified folder. **Cannot be used with `path`.**",
                      "key": "folderId",
                      "value": "<uuid>"
                    },
                    {
                      "description": "Filter content by path. **Cannot be used with `folderId`.** Examples:\n- `/folder/subfolder` - Returns the folder and any content it contains\n- `/folder/*` - Returns all folders and content recursively in the path\n- `/` - Returns all content in the organization\n",
                      "key": "path",
                      "value": "<string>"
                    },
                    {
                      "description": "UUID of organization membership. **Required when `scope` is `restricted`.**",
                      "key": "creatorId",
                      "value": "<uuid>"
                    },
                    {
                      "description": "Number of records per page (1-100)",
                      "key": "pageSize",
                      "value": "20"
                    },
                    {
                      "description": "Pagination cursor from previous response",
                      "key": "cursor",
                      "value": "<string>"
                    }
                  ]
                },
                "description": "Retrieve paginated list of documents and folders"
              },

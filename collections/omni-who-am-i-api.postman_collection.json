  "item": [
    {
      "id": "e36925b0-8978-469a-8c95-82e363ba9db4",
      "name": "Who Am I",
      "description": {
        "content": "Inspect your own user permissions",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "b79c1a80-2fa6-44d1-8886-361322210f4d",
          "name": "Get current identity and permissions",
          "request": {
            "name": "Get current identity and permissions",
            "description": {
              "content": "Returns the authenticated caller's own identity, API key scope, organization role, and resolved per-model permissions. \n\nSelf-scoped and available to non-admins: it lets a caller decide whether an action is permitted without attempting it. Pass `modelId` to scope `rolesByModel` to specific models.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "whoami"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "modelId",
                  "value": "<string>",
                  "description": "Optional model filter. A single model ID or a comma-separated list.\n\nWhen provided, `rolesByModel` in the response will contain only these models. When omitted, models the caller can access are returned up to a limit; see `rolesByModelTruncated`.\n"
                }
              ],
              "variable": [
                {
                  "description": "Your production Omni instance subdomain",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "0426a82a-3988-409d-9e73-5ac5dd605050",
              "name": "Caller's identity, key scope, org role, and per-model permissions",

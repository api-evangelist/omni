    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "instance",
      "value": "blobsrus"
    },
    {
      "key": "baseUrl",
      "value": "https://{{instance}}.omniapp.co/api"
    }
  ]
}
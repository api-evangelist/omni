        "type": "text/plain"
      },
      "item": [
        {
          "id": "9f452f11-9701-46dd-ab50-85ccf61a23fa",
          "name": "Assign or update user model role",
          "request": {
            "name": "Assign or update user model role",
            "description": {
              "content": "Assigns or updates a model role for a user. If the user already has a role for the specified model, this endpoint will update it to the new role.\n\nModel roles control what actions a user can perform on models and connections. To manage users, see the [User APIs](/api/users).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "users",
                ":userId",
                "model-roles"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "userId",
                  "description": "(Required) The ID of the user to assign or update a model role for."
                },
                {
                  "description": "Your production Omni instance subdomain",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],

      },
      "item": [
        {
          "id": "70cdbc4a-3bba-4507-b472-4a300dad3966",
          "name": "Get job status",
          "request": {
            "name": "Get job status",
            "description": {
              "content": "<Note>\n  Currently, this endpoint only supports schema refresh jobs. Job IDs from other job types will return an error.\n</Note>\n\nRetrieves the current status of an asynchronous job. The user authenticating the request must have **read** permissions on the connection.\n\nThis endpoint is used to check the status of jobs initiated by other API calls, such as schema refreshes. Poll this endpoint to determine when the job has completed.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "jobs",
                ":jobId",
                "status"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "jobId",
                  "description": "(Required) The job ID returned from an asynchronous operation such as [Refresh schema](/api/models/refresh-schema)"
                },
                {
                  "description": "Your production Omni instance subdomain",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },

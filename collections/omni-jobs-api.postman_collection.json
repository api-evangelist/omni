                          ],
                          "variable": [
                            {
                              "id": "c24f723f-cbfb-4c71-bbe9-4a62989ca94c",
                              "key": "jobId",
                              "value": "<uuid>",
                              "description": "(Required) The job ID returned from an asynchronous operation such as [Refresh schema](/api/models/refresh-schema)"
                            }
                          ]
                        },
                        "description": "Currently, this endpoint only supports schema refresh jobs. Job IDs from other job types will return an error.\n\nRetrieves the current status of an asynchronous job. The user authenticating the request must have **read** permissions on the connection.\n\nThis endpoint is used to check the status of jobs initiated by other API calls, such as schema refreshes. Poll this endpoint to determine when the job has completed."
                      },

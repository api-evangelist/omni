{
  "opencollection": "1.0.0",
  "info": {
    "name": "Omni AI Topics API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Topics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a topic",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.omniapp.co/api/v1/models/:modelId/topic/:topicName",
            "params": [
              {
                "name": "modelId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the model that contains the topic."
              },
              {
                "name": "topicName",
                "value": "",
                "type": "path",
                "description": "The name of the topic."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves a topic in a model by name."
        }
      ]
    }
  ],
  "bundled": true
}